  <!-- Hamburger Menu -->
  <div class="menu-toggle" id="menu-toggle">&#9776;</div>

  <!-- Navigation Links -->
  <ul class="nav-links" id="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/course">Add Course</a></li>
